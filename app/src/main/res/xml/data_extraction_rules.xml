<?xml version="1.0" encoding="utf-8"?>

<data-extraction-rules>

    <!--
        Cloud backup.

        FRIDAY's Room database contains the user's actual
        application data and should be included.

        friday_settings is intentionally excluded because
        it contains the Gemini API key.
    -->
    <cloud-backup>
        <include
            domain="database"
            path="friday_database" />
    </cloud-backup>

    <!--
        Device-to-device transfer.

        Transfer the same FRIDAY database when moving to
        another Android device.

        Settings containing the Gemini API key are not transferred.
    -->
    <device-transfer>
        <include
            domain="database"
            path="friday_database" />
    </device-transfer>

</data-extraction-rules>

